<?xml version="1.0"?>
<launch>
  <arg name="robot_type" default="husky" doc="Supported values: husky, go2"/>
  <arg name="world_name" default="world_large_dynamic.sdf"/>
  <arg name="start_rviz" default="true"/>

  <include if="$(eval arg('robot_type') == 'husky')"
           file="$(find semantic_segmentation_husky)/launch/seg_husky.launch">
    <arg name="world_name" value="$(arg world_name)"/>
  </include>

  <include if="$(eval arg('robot_type') == 'go2')"
           file="$(find semantic_segmentation_go2)/launch/seg_go2.launch">
    <arg name="world_name" value="$(arg world_name)"/>
    <arg name="start_rviz" value="$(arg start_rviz)"/>
  </include>
</launch>

