<?xml version="1.0"?>
<sdf version="1.8">
  <world name="semantic_segmentation_world">
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <gravity>0 0 -9.8</gravity>
    </physics>

    <scene>
      <ambient>0.45 0.47 0.42 1</ambient>
      <background>0.62 0.76 0.88 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 30 0 0 0</pose>
      <diffuse>0.88 0.84 0.72 1</diffuse>
      <specular>0.18 0.18 0.16 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.45 0.25 -0.86</direction>
    </light>

    <!-- 60 x 60 m continuous collision terrain. Height range is generated by
         scripts/generate_gentle_mountain_heightmap.py. -->
    <model name="gentle_mountain_terrain">
      <static>true</static>
      <link name="terrain_link">
        <collision name="terrain_collision">
          <geometry>
            <heightmap>
              <uri>file://gentle_mountain_heightmap.png</uri>
              <size>60 60 3.2</size>
              <pos>0 0 -0.8</pos>
            </heightmap>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.2</mu>
                <mu2>1.2</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="terrain_visual">
          <geometry>
            <heightmap>
              <use_terrain_paging>false</use_terrain_paging>
              <texture>
                <diffuse>file://gentle_mountain_surface.png</diffuse>
                <normal>file://gentle_mountain_flat_normal.png</normal>
                <size>5</size>
              </texture>
              <uri>file://gentle_mountain_heightmap.png</uri>
              <size>60 60 3.2</size>
              <pos>0 0 -0.8</pos>
            </heightmap>
          </geometry>
        </visual>
      </link>
      <plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label">
        <label>8</label>
      </plugin>
    </model>

    <!-- Low boundary walls keep autonomous trials on the heightmap. -->
    <model name="terrain_boundary">
      <static>true</static>
      <link name="boundary_link">
        <collision name="north_collision">
          <pose>0 29.5 1.35 0 0 0</pose>
          <geometry><box><size>60 0.5 3.4</size></box></geometry>
        </collision>
        <visual name="north_visual">
          <pose>0 29.5 1.35 0 0 0</pose>
          <geometry><box><size>60 0.5 3.4</size></box></geometry>
          <material><ambient>0.30 0.27 0.21 1</ambient><diffuse>0.38 0.34 0.26 1</diffuse></material>
        </visual>
        <collision name="south_collision">
          <pose>0 -29.5 1.35 0 0 0</pose>
          <geometry><box><size>60 0.5 3.4</size></box></geometry>
        </collision>
        <visual name="south_visual">
          <pose>0 -29.5 1.35 0 0 0</pose>
          <geometry><box><size>60 0.5 3.4</size></box></geometry>
          <material><ambient>0.30 0.27 0.21 1</ambient><diffuse>0.38 0.34 0.26 1</diffuse></material>
        </visual>
        <collision name="east_collision">
          <pose>29.5 0 1.35 0 0 0</pose>
          <geometry><box><size>0.5 60 3.4</size></box></geometry>
        </collision>
        <visual name="east_visual">
          <pose>29.5 0 1.35 0 0 0</pose>
          <geometry><box><size>0.5 60 3.4</size></box></geometry>
          <material><ambient>0.30 0.27 0.21 1</ambient><diffuse>0.38 0.34 0.26 1</diffuse></material>
        </visual>
        <collision name="west_collision">
          <pose>-29.5 0 1.35 0 0 0</pose>
          <geometry><box><size>0.5 60 3.4</size></box></geometry>
        </collision>
        <visual name="west_visual">
          <pose>-29.5 0 1.35 0 0 0</pose>
          <geometry><box><size>0.5 60 3.4</size></box></geometry>
          <material><ambient>0.30 0.27 0.21 1</ambient><diffuse>0.38 0.34 0.26 1</diffuse></material>
        </visual>
      </link>
      <plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label">
        <label>4</label>
      </plugin>
    </model>

    <!-- Irregular boulder groups are sparse, leaving multiple navigation routes. -->
    <model name="mountain_rocks">
      <static>true</static>
      <link name="rocks_link">
        <collision name="rock_1_collision"><pose>-12 8 2.15 0 0 0</pose><geometry><sphere><radius>0.85</radius></sphere></geometry></collision>
        <visual name="rock_1_visual"><pose>-12 8 2.15 0 0 0</pose><geometry><sphere><radius>0.85</radius></sphere></geometry><material><ambient>0.29 0.28 0.25 1</ambient><diffuse>0.40 0.38 0.33 1</diffuse></material></visual>
        <collision name="rock_2_collision"><pose>-10.9 8.3 2.05 0 0 0</pose><geometry><sphere><radius>0.62</radius></sphere></geometry></collision>
        <visual name="rock_2_visual"><pose>-10.9 8.3 2.05 0 0 0</pose><geometry><sphere><radius>0.62</radius></sphere></geometry><material><ambient>0.25 0.25 0.23 1</ambient><diffuse>0.36 0.35 0.31 1</diffuse></material></visual>

        <collision name="rock_3_collision"><pose>15 -8 0.75 0 0 0</pose><geometry><sphere><radius>0.70</radius></sphere></geometry></collision>
        <visual name="rock_3_visual"><pose>15 -8 0.75 0 0 0</pose><geometry><sphere><radius>0.70</radius></sphere></geometry><material><ambient>0.31 0.29 0.25 1</ambient><diffuse>0.43 0.40 0.34 1</diffuse></material></visual>
        <collision name="rock_4_collision"><pose>15.9 -8.5 0.58 0 0 0</pose><geometry><sphere><radius>0.48</radius></sphere></geometry></collision>
        <visual name="rock_4_visual"><pose>15.9 -8.5 0.58 0 0 0</pose><geometry><sphere><radius>0.48</radius></sphere></geometry><material><ambient>0.26 0.25 0.22 1</ambient><diffuse>0.37 0.36 0.31 1</diffuse></material></visual>

        <collision name="rock_5_collision"><pose>7 18 1.15 0 0 0</pose><geometry><sphere><radius>0.82</radius></sphere></geometry></collision>
        <visual name="rock_5_visual"><pose>7 18 1.15 0 0 0</pose><geometry><sphere><radius>0.82</radius></sphere></geometry><material><ambient>0.28 0.27 0.24 1</ambient><diffuse>0.40 0.38 0.33 1</diffuse></material></visual>
        <collision name="rock_6_collision"><pose>-19 -13 1.35 0 0 0</pose><geometry><sphere><radius>0.72</radius></sphere></geometry></collision>
        <visual name="rock_6_visual"><pose>-19 -13 1.35 0 0 0</pose><geometry><sphere><radius>0.72</radius></sphere></geometry><material><ambient>0.30 0.28 0.24 1</ambient><diffuse>0.42 0.39 0.33 1</diffuse></material></visual>
      </link>
      <plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label">
        <label>5</label>
      </plugin>
    </model>

    <!-- Fallen logs add low obstacles that are different from the broad slopes. -->
    <model name="fallen_logs">
      <static>true</static>
      <link name="logs_link">
        <collision name="log_1_collision">
          <pose>-5 13 1.62 0 1.5708 0.35</pose>
          <geometry><cylinder><radius>0.22</radius><length>3.8</length></cylinder></geometry>
        </collision>
        <visual name="log_1_visual">
          <pose>-5 13 1.62 0 1.5708 0.35</pose>
          <geometry><cylinder><radius>0.22</radius><length>3.8</length></cylinder></geometry>
          <material><ambient>0.25 0.13 0.055 1</ambient><diffuse>0.38 0.20 0.08 1</diffuse></material>
        </visual>
        <collision name="log_2_collision">
          <pose>11 6 0.44 0 1.5708 -0.7</pose>
          <geometry><cylinder><radius>0.18</radius><length>3.2</length></cylinder></geometry>
        </collision>
        <visual name="log_2_visual">
          <pose>11 6 0.44 0 1.5708 -0.7</pose>
          <geometry><cylinder><radius>0.18</radius><length>3.2</length></cylinder></geometry>
          <material><ambient>0.23 0.12 0.05 1</ambient><diffuse>0.36 0.19 0.07 1</diffuse></material>
        </visual>
      </link>
      <plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label">
        <label>5</label>
      </plugin>
    </model>

    <!-- A few trunks provide taller landmarks for the semantic cameras. -->
    <model name="sparse_trees">
      <static>true</static>
      <link name="trees_link">
        <collision name="trunk_1_collision"><pose>-21 19 1.65 0 0 0</pose><geometry><cylinder><radius>0.27</radius><length>2.8</length></cylinder></geometry></collision>
        <visual name="trunk_1_visual"><pose>-21 19 1.65 0 0 0</pose><geometry><cylinder><radius>0.27</radius><length>2.8</length></cylinder></geometry><material><ambient>0.24 0.13 0.06 1</ambient><diffuse>0.36 0.20 0.08 1</diffuse></material></visual>
        <visual name="crown_1_visual"><pose>-21 19 3.45 0 0 0</pose><geometry><sphere><radius>1.25</radius></sphere></geometry><material><ambient>0.08 0.22 0.07 1</ambient><diffuse>0.12 0.34 0.10 1</diffuse></material></visual>

        <collision name="trunk_2_collision"><pose>20 9 2.80 0 0 0</pose><geometry><cylinder><radius>0.30</radius><length>3.0</length></cylinder></geometry></collision>
        <visual name="trunk_2_visual"><pose>20 9 2.80 0 0 0</pose><geometry><cylinder><radius>0.30</radius><length>3.0</length></cylinder></geometry><material><ambient>0.23 0.12 0.05 1</ambient><diffuse>0.35 0.19 0.07 1</diffuse></material></visual>
        <visual name="crown_2_visual"><pose>20 9 4.75 0 0 0</pose><geometry><sphere><radius>1.35</radius></sphere></geometry><material><ambient>0.07 0.20 0.06 1</ambient><diffuse>0.11 0.32 0.09 1</diffuse></material></visual>

        <collision name="trunk_3_collision"><pose>20 -21 2.58 0 0 0</pose><geometry><cylinder><radius>0.25</radius><length>2.6</length></cylinder></geometry></collision>
        <visual name="trunk_3_visual"><pose>20 -21 2.58 0 0 0</pose><geometry><cylinder><radius>0.25</radius><length>2.6</length></cylinder></geometry><material><ambient>0.24 0.13 0.06 1</ambient><diffuse>0.36 0.20 0.08 1</diffuse></material></visual>
        <visual name="crown_3_visual"><pose>20 -21 4.33 0 0 0</pose><geometry><sphere><radius>1.15</radius></sphere></geometry><material><ambient>0.09 0.23 0.07 1</ambient><diffuse>0.13 0.35 0.10 1</diffuse></material></visual>
      </link>
      <plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label">
        <label>5</label>
      </plugin>
    </model>

    <include>
      <uri>model://go2_semantic_omni</uri>
      <name>go2_semantic_omni</name>
      <!-- The generated map is flat and exactly z=0 in a 3 m radius here. -->
      <pose>0 0 0.34 0 0 0</pose>
    </include>
  </world>
</sdf>
