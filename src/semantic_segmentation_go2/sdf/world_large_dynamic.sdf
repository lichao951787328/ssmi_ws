<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="semantic_segmentation_world">
    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-imu-system"
            name="ignition::gazebo::systems::Imu"/>

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <gravity>0 0 -9.8</gravity>
    </physics>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>120 120</size></plane>
          </geometry>
          <surface>
            <friction><ode><mu>100</mu><mu2>50</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Original semantic objects are retained with their original labels. -->
    <include>
      <name>office_chair</name>
      <pose>3 7 0 0 0 3.14</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Office Chair</uri>
      <plugin filename="ignition-gazebo-label-system"
              name="ignition::gazebo::systems::Label"><label>1</label></plugin>
    </include>
    <include>
      <name>television</name>
      <pose>6 -3 3 0 0 -1.0</pose>
      <uri>https://fuel.gazebosim.org/1.0/makerspet/models/tv_65in_emissive</uri>
      <plugin filename="ignition-gazebo-label-system"
              name="ignition::gazebo::systems::Label"><label>2</label></plugin>
    </include>
    <include>
      <name>reflective_table</name>
      <pose>7 2 0 0 0 0</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Reflective table</uri>
      <plugin filename="ignition-gazebo-label-system"
              name="ignition::gazebo::systems::Label"><label>3</label></plugin>
    </include>

    <!-- 100 x 100 m outer boundary, retaining boundary-wall label 4. -->
    <model name="outer_boundary">
      <static>true</static>
      <link name="walls">
        <collision name="north_collision"><pose>0 49.5 2 0 0 0</pose><geometry><box><size>100 1 4</size></box></geometry></collision>
        <visual name="north_visual"><pose>0 49.5 2 0 0 0</pose><geometry><box><size>100 1 4</size></box></geometry><material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material></visual>
        <collision name="south_collision"><pose>0 -49.5 2 0 0 0</pose><geometry><box><size>100 1 4</size></box></geometry></collision>
        <visual name="south_visual"><pose>0 -49.5 2 0 0 0</pose><geometry><box><size>100 1 4</size></box></geometry><material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material></visual>
        <collision name="east_collision"><pose>49.5 0 2 0 0 0</pose><geometry><box><size>1 100 4</size></box></geometry></collision>
        <visual name="east_visual"><pose>49.5 0 2 0 0 0</pose><geometry><box><size>1 100 4</size></box></geometry><material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material></visual>
        <collision name="west_collision"><pose>-49.5 0 2 0 0 0</pose><geometry><box><size>1 100 4</size></box></geometry></collision>
        <visual name="west_visual"><pose>-49.5 0 2 0 0 0</pose><geometry><box><size>1 100 4</size></box></geometry><material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material></visual>
      </link>
      <plugin filename="ignition-gazebo-label-system"
              name="ignition::gazebo::systems::Label"><label>4</label></plugin>
    </model>

    <!-- Additional bent corridors. All segments retain maze-wall label 5. -->
    <model name="large_bent_maze">
      <static>true</static>
      <link name="maze_walls">
        <!-- West-side S bend -->
        <collision name="m01c"><pose>-34 -25 2 0 0 0</pose><geometry><box><size>1 34 4</size></box></geometry></collision>
        <visual name="m01v"><pose>-34 -25 2 0 0 0</pose><geometry><box><size>1 34 4</size></box></geometry><material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material></visual>
        <collision name="m02c"><pose>-24 -8 2 0 0 0</pose><geometry><box><size>20 1 4</size></box></geometry></collision>
        <visual name="m02v"><pose>-24 -8 2 0 0 0</pose><geometry><box><size>20 1 4</size></box></geometry><material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material></visual>
        <collision name="m03c"><pose>-14 2 2 0 0 0</pose><geometry><box><size>1 20 4</size></box></geometry></collision>
        <visual name="m03v"><pose>-14 2 2 0 0 0</pose><geometry><box><size>1 20 4</size></box></geometry><material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material></visual>
        <collision name="m04c"><pose>-25 12 2 0 0 0</pose><geometry><box><size>22 1 4</size></box></geometry></collision>
        <visual name="m04v"><pose>-25 12 2 0 0 0</pose><geometry><box><size>22 1 4</size></box></geometry><material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material></visual>
        <collision name="m05c"><pose>-36 25 2 0 0 0</pose><geometry><box><size>1 26 4</size></box></geometry></collision>
        <visual name="m05v"><pose>-36 25 2 0 0 0</pose><geometry><box><size>1 26 4</size></box></geometry><material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material></visual>

        <!-- North-side U bend -->
        <collision name="m06c"><pose>-16 35 2 0 0 0</pose><geometry><box><size>24 1 4</size></box></geometry></collision>
        <visual name="m06v"><pose>-16 35 2 0 0 0</pose><geometry><box><size>24 1 4</size></box></geometry><material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material></visual>
        <collision name="m07c"><pose>-4 29 2 0 0 0</pose><geometry><box><size>1 12 4</size></box></geometry></collision>
        <visual name="m07v"><pose>-4 29 2 0 0 0</pose><geometry><box><size>1 12 4</size></box></geometry><material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material></visual>
        <collision name="m08c"><pose>8 23 2 0 0 0</pose><geometry><box><size>24 1 4</size></box></geometry></collision>
        <visual name="m08v"><pose>8 23 2 0 0 0</pose><geometry><box><size>24 1 4</size></box></geometry><material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material></visual>
        <collision name="m09c"><pose>20 31 2 0 0 0</pose><geometry><box><size>1 16 4</size></box></geometry></collision>
        <visual name="m09v"><pose>20 31 2 0 0 0</pose><geometry><box><size>1 16 4</size></box></geometry><material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material></visual>
        <collision name="m10c"><pose>31 39 2 0 0 0</pose><geometry><box><size>22 1 4</size></box></geometry></collision>
        <visual name="m10v"><pose>31 39 2 0 0 0</pose><geometry><box><size>22 1 4</size></box></geometry><material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material></visual>

        <!-- East-side zigzag -->
        <collision name="m11c"><pose>34 21 2 0 0 0</pose><geometry><box><size>1 20 4</size></box></geometry></collision>
        <visual name="m11v"><pose>34 21 2 0 0 0</pose><geometry><box><size>1 20 4</size></box></geometry><material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material></visual>
        <collision name="m12c"><pose>27 11 2 0 0 0</pose><geometry><box><size>14 1 4</size></box></geometry></collision>
        <visual name="m12v"><pose>27 11 2 0 0 0</pose><geometry><box><size>14 1 4</size></box></geometry><material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material></visual>
        <collision name="m13c"><pose>20 1 2 0 0 0</pose><geometry><box><size>1 20 4</size></box></geometry></collision>
        <visual name="m13v"><pose>20 1 2 0 0 0</pose><geometry><box><size>1 20 4</size></box></geometry><material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material></visual>
        <collision name="m14c"><pose>30 -9 2 0 0 0</pose><geometry><box><size>20 1 4</size></box></geometry></collision>
        <visual name="m14v"><pose>30 -9 2 0 0 0</pose><geometry><box><size>20 1 4</size></box></geometry><material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material></visual>
        <collision name="m15c"><pose>40 -21 2 0 0 0</pose><geometry><box><size>1 24 4</size></box></geometry></collision>
        <visual name="m15v"><pose>40 -21 2 0 0 0</pose><geometry><box><size>1 24 4</size></box></geometry><material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material></visual>

        <!-- South-side turns -->
        <collision name="m16c"><pose>27 -33 2 0 0 0</pose><geometry><box><size>26 1 4</size></box></geometry></collision>
        <visual name="m16v"><pose>27 -33 2 0 0 0</pose><geometry><box><size>26 1 4</size></box></geometry><material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material></visual>
        <collision name="m17c"><pose>14 -26 2 0 0 0</pose><geometry><box><size>1 14 4</size></box></geometry></collision>
        <visual name="m17v"><pose>14 -26 2 0 0 0</pose><geometry><box><size>1 14 4</size></box></geometry><material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material></visual>
        <collision name="m18c"><pose>2 -19 2 0 0 0</pose><geometry><box><size>24 1 4</size></box></geometry></collision>
        <visual name="m18v"><pose>2 -19 2 0 0 0</pose><geometry><box><size>24 1 4</size></box></geometry><material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material></visual>
        <collision name="m19c"><pose>-10 -30 2 0 0 0</pose><geometry><box><size>1 22 4</size></box></geometry></collision>
        <visual name="m19v"><pose>-10 -30 2 0 0 0</pose><geometry><box><size>1 22 4</size></box></geometry><material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material></visual>
        <collision name="m20c"><pose>-20 -41 2 0 0 0</pose><geometry><box><size>20 1 4</size></box></geometry></collision>
        <visual name="m20v"><pose>-20 -41 2 0 0 0</pose><geometry><box><size>20 1 4</size></box></geometry><material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material></visual>

        <!-- Retained central L-shaped maze elements. -->
        <collision name="m21c"><pose>5 5 2 0 0 0</pose><geometry><box><size>10 1 4</size></box></geometry></collision>
        <visual name="m21v"><pose>5 5 2 0 0 0</pose><geometry><box><size>10 1 4</size></box></geometry><material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material></visual>
        <collision name="m22c"><pose>5 5 2 0 0 0</pose><geometry><box><size>1 10 4</size></box></geometry></collision>
        <visual name="m22v"><pose>5 5 2 0 0 0</pose><geometry><box><size>1 10 4</size></box></geometry><material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material></visual>
      </link>
      <plugin filename="ignition-gazebo-label-system"
              name="ignition::gazebo::systems::Label"><label>5</label></plugin>
    </model>

    <!-- Dynamic obstacles use label 6 and loop through separate corridors. -->
    <model name="dynamic_obstacle_1">
      <static>true</static>
      <pose>-28 -4 0.6 0 0 0</pose>
      <link name="body">
        <inertial><mass>1</mass><inertia><ixx>0.12</ixx><iyy>0.12</iyy><izz>0.12</izz></inertia></inertial>
        <velocity_decay><linear>0.4</linear><angular>0.8</angular></velocity_decay>
        <collision name="collision"><geometry><box><size>0.8 0.8 1.2</size></box></geometry><surface><friction><ode><mu>0.2</mu><mu2>0.2</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.8 0.8 1.2</size></box></geometry><material><ambient>0 0.4 1 1</ambient><diffuse>0 0.4 1 1</diffuse></material></visual>
      </link>
      <plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label"><label>6</label></plugin>
      <plugin filename="libssmi_periodic_motion_system.so" name="semantic_segmentation_husky::PeriodicMotionSystem">
        <offset>10 0 0</offset><period>30</period><phase>7.5</phase>
      </plugin>
    </model>

    <model name="dynamic_obstacle_2">
      <static>true</static>
      <pose>2 17 0.6 0 0 0</pose>
      <link name="body">
        <inertial><mass>1</mass><inertia><ixx>0.12</ixx><iyy>0.12</iyy><izz>0.12</izz></inertia></inertial>
        <velocity_decay><linear>0.4</linear><angular>0.8</angular></velocity_decay>
        <collision name="collision"><geometry><cylinder><radius>0.45</radius><length>1.2</length></cylinder></geometry><surface><friction><ode><mu>0.2</mu><mu2>0.2</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><cylinder><radius>0.45</radius><length>1.2</length></cylinder></geometry><material><ambient>0 0.8 0.8 1</ambient><diffuse>0 0.8 0.8 1</diffuse></material></visual>
      </link>
      <plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label"><label>6</label></plugin>
      <plugin filename="libssmi_periodic_motion_system.so" name="semantic_segmentation_husky::PeriodicMotionSystem">
        <offset>14 0 0</offset><period>42</period><phase>10.5</phase>
      </plugin>
    </model>

    <model name="dynamic_obstacle_3">
      <static>true</static>
      <pose>24 -27 0.6 0 0 0</pose>
      <link name="body">
        <inertial><mass>1</mass><inertia><ixx>0.12</ixx><iyy>0.12</iyy><izz>0.12</izz></inertia></inertial>
        <velocity_decay><linear>0.4</linear><angular>0.8</angular></velocity_decay>
        <collision name="collision"><geometry><box><size>1.0 0.7 1.2</size></box></geometry><surface><friction><ode><mu>0.2</mu><mu2>0.2</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>1.0 0.7 1.2</size></box></geometry><material><ambient>0.6 0.2 1 1</ambient><diffuse>0.6 0.2 1 1</diffuse></material></visual>
      </link>
      <plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label"><label>6</label></plugin>
      <plugin filename="libssmi_periodic_motion_system.so" name="semantic_segmentation_husky::PeriodicMotionSystem">
        <offset>10 10 0</offset><period>45</period><phase>11.25</phase>
      </plugin>
    </model>

    <!-- Five additional movers are concentrated around the initial robot area
         and central corridors so their motion is immediately observable. -->
    <model name="dynamic_obstacle_4">
      <static>true</static>
      <pose>-8 -10 0.55 0 0 0</pose>
      <link name="body">
        <inertial><mass>1</mass><inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia></inertial>
        <velocity_decay><linear>0.4</linear><angular>0.8</angular></velocity_decay>
        <collision name="collision"><geometry><cylinder><radius>0.4</radius><length>1.1</length></cylinder></geometry><surface><friction><ode><mu>0.2</mu><mu2>0.2</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><cylinder><radius>0.4</radius><length>1.1</length></cylinder></geometry><material><ambient>0 0.8 0.3 1</ambient><diffuse>0 0.8 0.3 1</diffuse></material></visual>
      </link>
      <plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label"><label>6</label></plugin>
      <plugin filename="libssmi_periodic_motion_system.so" name="semantic_segmentation_husky::PeriodicMotionSystem">
        <offset>16 0 0</offset><period>48</period><phase>12</phase>
      </plugin>
    </model>

    <model name="dynamic_obstacle_5">
      <static>true</static>
      <pose>-7 8 0.55 0 0 1.5708</pose>
      <link name="body">
        <inertial><mass>1</mass><inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia></inertial>
        <velocity_decay><linear>0.4</linear><angular>0.8</angular></velocity_decay>
        <collision name="collision"><geometry><box><size>0.7 0.7 1.1</size></box></geometry><surface><friction><ode><mu>0.2</mu><mu2>0.2</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.7 0.7 1.1</size></box></geometry><material><ambient>1 0.3 0.8 1</ambient><diffuse>1 0.3 0.8 1</diffuse></material></visual>
      </link>
      <plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label"><label>6</label></plugin>
      <plugin filename="libssmi_periodic_motion_system.so" name="semantic_segmentation_husky::PeriodicMotionSystem">
        <offset>0 12 0</offset><period>36</period><phase>9</phase>
      </plugin>
    </model>

    <model name="dynamic_obstacle_6">
      <static>true</static>
      <pose>10 8 0.55 0 0 0</pose>
      <link name="body">
        <inertial><mass>1</mass><inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia></inertial>
        <velocity_decay><linear>0.4</linear><angular>0.8</angular></velocity_decay>
        <collision name="collision"><geometry><sphere><radius>0.55</radius></sphere></geometry><surface><friction><ode><mu>0.2</mu><mu2>0.2</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><sphere><radius>0.55</radius></sphere></geometry><material><ambient>1 0.5 0 1</ambient><diffuse>1 0.5 0 1</diffuse></material></visual>
      </link>
      <plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label"><label>6</label></plugin>
      <plugin filename="libssmi_periodic_motion_system.so" name="semantic_segmentation_husky::PeriodicMotionSystem">
        <offset>7 0 0</offset><period>22</period><phase>5.5</phase>
      </plugin>
    </model>

    <model name="dynamic_obstacle_7">
      <static>true</static>
      <pose>-6 -14 0.55 0 0 0</pose>
      <link name="body">
        <inertial><mass>1</mass><inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia></inertial>
        <velocity_decay><linear>0.4</linear><angular>0.8</angular></velocity_decay>
        <collision name="collision"><geometry><box><size>0.9 0.6 1.1</size></box></geometry><surface><friction><ode><mu>0.2</mu><mu2>0.2</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.9 0.6 1.1</size></box></geometry><material><ambient>0.2 0.9 1 1</ambient><diffuse>0.2 0.9 1 1</diffuse></material></visual>
      </link>
      <plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label"><label>6</label></plugin>
      <plugin filename="libssmi_periodic_motion_system.so" name="semantic_segmentation_husky::PeriodicMotionSystem">
        <offset>14 0 0</offset><period>42</period><phase>10.5</phase>
      </plugin>
    </model>

    <model name="dynamic_obstacle_8">
      <static>true</static>
      <pose>10 -4 0.55 0 0 -1.5708</pose>
      <link name="body">
        <inertial><mass>1</mass><inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia></inertial>
        <velocity_decay><linear>0.4</linear><angular>0.8</angular></velocity_decay>
        <collision name="collision"><geometry><cylinder><radius>0.42</radius><length>1.1</length></cylinder></geometry><surface><friction><ode><mu>0.2</mu><mu2>0.2</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><cylinder><radius>0.42</radius><length>1.1</length></cylinder></geometry><material><ambient>0.9 0.9 0.1 1</ambient><diffuse>0.9 0.9 0.1 1</diffuse></material></visual>
      </link>
      <plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label"><label>6</label></plugin>
      <plugin filename="libssmi_periodic_motion_system.so" name="semantic_segmentation_husky::PeriodicMotionSystem">
        <offset>0 -12 0</offset><period>36</period><phase>9</phase>
      </plugin>
    </model>

    <!-- Straight-through staircase near the initial robot area: ascend in +X,
         cross the top platform, then descend while continuing in +X. Each
         height change is 0.10 m. The structure is 6.65 m long, 2.0 m wide
         and reaches 0.8 m. All parts belong to semantic class 7. -->
    <model name="staircase">
      <static>true</static>
      <pose>-8 0 0 0 0 0</pose>
      <link name="stairs">
        <collision name="step_1_collision">
          <pose>0.175 0 0.05 0 0 0</pose>
          <geometry><box><size>0.35 2.0 0.10</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="step_1_visual">
          <pose>0.175 0 0.05 0 0 0</pose>
          <geometry><box><size>0.35 2.0 0.10</size></box></geometry>
          <material><ambient>0.35 0.45 0.55 1</ambient><diffuse>0.45 0.58 0.70 1</diffuse></material>
        </visual>

        <collision name="step_2_collision">
          <pose>0.525 0 0.10 0 0 0</pose>
          <geometry><box><size>0.35 2.0 0.20</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="step_2_visual">
          <pose>0.525 0 0.10 0 0 0</pose>
          <geometry><box><size>0.35 2.0 0.20</size></box></geometry>
          <material><ambient>0.35 0.45 0.55 1</ambient><diffuse>0.45 0.58 0.70 1</diffuse></material>
        </visual>

        <collision name="step_3_collision">
          <pose>0.875 0 0.15 0 0 0</pose>
          <geometry><box><size>0.35 2.0 0.30</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="step_3_visual">
          <pose>0.875 0 0.15 0 0 0</pose>
          <geometry><box><size>0.35 2.0 0.30</size></box></geometry>
