    <!-- Dynamic obstacles use label 6 and loop through separate corridors. -->
    <model name="dynamic_obstacle_1">
      <static>true</static>
      <pose>-28 -4 0.6 0 0 0</pose>
      <link name="body">
        <inertial>
          <mass>1</mass>
          <inertia>
            <ixx>0.12</ixx>
            <iyy>0.12</iyy>
            <izz>0.12</izz>
          </inertia>
        </inertial>
        <velocity_decay>
          <linear>0.4</linear>
          <angular>0.8</angular>
